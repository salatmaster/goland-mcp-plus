<idea-plugin>
    <id>io.github.salatmaster.goland-mcp-plus</id>
    <name>Go MCP++</name>
    <vendor url="https://github.com/salatmaster/goland-mcp-plus">salatmaster</vendor>
    <description><![CDATA[
        Extends the built-in JetBrains MCP server with Go semantic tools:
        interface implementations, interface satisfaction diagnostics, and
        symbol lookup by human-readable reference.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.mcpServer</depends>
    <depends>org.jetbrains.plugins.go</depends>

    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolset implementation="dev.salatmaster.golandmcp.toolset.SymbolToolset"/>
        <mcpServer.mcpToolset implementation="dev.salatmaster.golandmcp.toolset.InterfaceToolset"/>
        <mcpServer.mcpToolset implementation="dev.salatmaster.golandmcp.toolset.PackageToolset"/>
        <mcpServer.mcpToolset implementation="dev.salatmaster.golandmcp.toolset.UsagesToolset"/>
        <mcpServer.mcpToolset implementation="dev.salatmaster.golandmcp.toolset.BatchToolset"/>
        <mcpServer.mcpToolset implementation="dev.salatmaster.golandmcp.toolset.ToolchainToolset"/>
        <mcpServer.mcpToolset implementation="dev.salatmaster.golandmcp.toolset.GenerationToolset"/>
        <mcpServer.mcpToolset implementation="dev.salatmaster.golandmcp.toolset.RefactoringToolset"/>
    </extensions>
</idea-plugin>
